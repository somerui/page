body {
	max-width: 1100px;
	margin: 40px auto;
	padding: 0 20px;
	font-family: sans-serif;
	line-height: 1.6;
	background-color: black;
	color: #ccc;
	font-family: monospace;
}
#sign {
	display: flex;
	width: fit-content;
	max-width: 100%;
	padding: 0.75em 1em;
	margin: 1em 0;
	overflow-x: auto;
	overflow-y: auto;
	white-space: pre;
	word-break: normal;
	overflow-wrap: normal;
	background: #111;
	color: #eee;
	line-height: 1.5;
	-webkit-overflow-scrolling: touch;
}
a{color: darkcyan;text-decoration: none;}
a:hover{color: aqua;}
h2{color: white;}
#hidden{color: black;}
svg{display: flex;justify-content: center;align-items: center;width: 100%;margin: 0 auto;width: 50%;height: auto;max-width: 100%;display: block;}